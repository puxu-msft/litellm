[Unit]
Description=Caddy for litellm
Documentation=https://caddyserver.com/docs/

After=network.target
# —— 可选：让 LB 在后端之后启动（前提是 litellm/copilot-api 也做成 systemd 单元）——
# After=litellm.service copilot-api.service
# Wants=litellm.service copilot-api.service

# 崩溃重启风暴熔断（10s 内重启超 5 次则放弃并置为 failed）。
# 注意：StartLimit* 属 [Unit] 段，放 [Service] 会被 systemd 忽略并告警
StartLimitIntervalSec=10s
StartLimitBurst=5

[Service]
Type=notify

# 启动前先校验配置，坏配置直接失败、不顶掉正在跑的实例
ExecStartPre=/home/linuxbrew/.linuxbrew/bin/caddy validate --config /home/xp/.config/litellm/Caddyfile --adapter caddyfile
ExecStart=/home/linuxbrew/.linuxbrew/bin/caddy run --environ --config /home/xp/.config/litellm/Caddyfile --adapter caddyfile

Restart=on-failure
RestartSec=3s
TimeoutStopSec=45s

# 平滑热更（需要 Caddyfile 里开启 admin 端点）
# 否则用 `systemctl --user restart caddy-lb`，会瞬断（用户接受）
# ExecReload=/home/linuxbrew/.linuxbrew/bin/caddy reload --config /home/xp/.config/litellm/Caddyfile --adapter caddyfile --force

# —— 可选：崩溃重启风暴的熔断见 [Unit] 段的 StartLimit*（放 [Service] 会被忽略）——
# —— 可选：资源上限。大量并发 SSE 长连接吃 fd，user 服务默认 fd 上限可能不够，建议放开 LimitNOFILE ——
# LimitNOFILE=1048576
# MemoryMax=1G

# —— 可选：安全加固 ——
NoNewPrivileges=true
PrivateTmp=true
# /usr /boot /etc 只读；不影响读 $HOME
ProtectSystem=full
# ProtectHome=none

[Install]
WantedBy=default.target
